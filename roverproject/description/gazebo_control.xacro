<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Gazebo plugins for simulation control and state publishing -->
    <gazebo>
        <!-- Differential drive plugin for Gazebo simulation -->
        <plugin name="gz::sim::systems::DiffDrive" filename="gz-sim-diff-drive-system">

            <!-- Wheel joint definitions for left and right sides -->
            <left_joint>Fleft_wheel_joint</left_joint>
            <left_joint>Rleft_wheel_joint</left_joint>
            <right_joint>Fright_wheel_joint</right_joint>
            <right_joint>Rright_wheel_joint</right_joint>
            <wheel_separation>0.358</wheel_separation>               <!-- Distance between left and right wheels (meters) -->
            <wheel_radius>0.08</wheel_radius>                        <!-- Wheel radius (meters) -->


            <!-- Motion limits -->
            <!-- <max_wheel_torque>200</max_wheel_torque> -->        <!-- Optional: Maximum torque per wheel (Nm) -->
            <max_linear_acceleration>0.33</max_linear_acceleration>  <!-- Maximum linear acceleration (m/s^2) -->

            <!-- Command input topic for velocity commands -->
            <topic>cmd_vel</topic>

            
            <!-- Odometry and TF output configuration -->
            <frame_id>odom</frame_id>                                <!-- Odometry reference frame -->
            <child_frame_id>base_link</child_frame_id>               <!-- Robot base frame -->
            <odom_topic>odom</odom_topic>                            <!-- Odometry topic name -->
            <odom_publisher_frequency>30</odom_publisher_frequency>  <!-- Odometry publishing rate (Hz) -->
            <tf_topic>/tf</tf_topic>                                 <!-- TF topic for transforms -->

        </plugin>

        <!-- Joint state publisher plugin for Gazebo -->
        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>                              <!-- ROS topic for publishing joint states -->
            <left_joint>Fleft_wheel_joint</left_joint>
            <left_joint>Rleft_wheel_joint</left_joint>
            <right_joint>Fright_wheel_joint</right_joint>
            <right_joint>Rright_wheel_joint</right_joint>
        </plugin>
    </gazebo>

</robot>