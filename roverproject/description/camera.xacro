<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <!-- Fixed joint attaching the camera to the chassis -->
    <joint name="camera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="camera_link"/>
        <origin xyz="0.21 0 0" rpy="0 0.18 0"/>
    </joint>
    
    <!-- Camera link with visual mesh -->
    <link name="camera_link">
        <visual>
            <origin xyz="0 -0.0125 -0.012" rpy="${pi/2} 0 ${pi/2}"/>
            <geometry>
                <mesh filename="package://roverproject/meshes/cam.dae"/>
            </geometry>
        </visual>
    </link>

    <!-- Optical frame for the camera (sets conventional camera frame)-->
    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    
    <!-- Optical link (empty, used for correct camera frame alignment) -->
    <link name="camera_link_optical"></link>


    <!-- Gazebo-specific configuration for the camera sensor -->
    <gazebo reference="camera_link">
        <material>Gazebo/Black</material>

        <!-- Camera sensor plugin for Gazebo simulation -->
        <sensor name="camera" type="camera">
            <pose> 0 0 0 0 0 0 </pose>                                     <!-- Sensor pose relative to camera_link -->
            <visualize>true</visualize>                                    <!-- Show camera frustum in Gazebo -->
            <update_rate>10</update_rate>                                  <!-- Camera frame rate (Hz) -->
            <camera>
                <camera_info_topic>camera/camera_info</camera_info_topic>  <!-- ROS topic for camera info -->
                <horizontal_fov>1.089</horizontal_fov>                     <!-- Horizontal field of view (radians) -->
                <image>
                    <format>R8G8B8</format>                                <!-- Image encoding format -->
                    <width>640</width>                                     <!-- Image width (pixels) -->
                    <height>480</height>                                   <!-- Image height (pixels) -->
                </image>
                <clip>
                    <near>0.05</near>                                      <!-- Near clipping plane (meters) -->
                    <far>8.0</far>                                         <!-- Far clipping plane (meters) -->
                </clip>
            </camera>
            <topic>camera/image_raw</topic>                                <!-- ROS topic for camera images -->
            <gz_frame_id>camera_link_optical</gz_frame_id>                 <!-- Frame ID for Gazebo plugin -->
        </sensor>
    </gazebo>

</robot>